# Copy to .env.local for local dev. On Netlify, add these under
# Site configuration → Environment variables, then redeploy.

# Your live domain, no trailing slash. Used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://toollantern.netlify.app

# Google Analytics 4 Measurement ID (looks like G-XXXXXXXXXX). Ignored if GTM is set.
NEXT_PUBLIC_GA4_ID=

# Google Tag Manager container ID (looks like GTM-XXXXXXX). If set, configure GA4 inside GTM.
NEXT_PUBLIC_GTM_ID=

# Google Search Console HTML-tag verification: only the content value, e.g. abc123XYZ...
NEXT_PUBLIC_GSC_VERIFICATION=

# Google AdSense publisher ID (ca-pub-XXXXXXXXXXXXXXXX). Leave empty until approved.
NEXT_PUBLIC_ADSENSE_CLIENT=

# Optional: @handle for Twitter/X cards
NEXT_PUBLIC_TWITTER_HANDLE=
